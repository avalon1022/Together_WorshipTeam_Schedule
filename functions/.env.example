# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (README 3단계)
# 카카오 개발자 사이트 [앱] > [플랫폼 키] > REST API 키
KAKAO_REST_API_KEY=
# 앱 주소 (예: https://schedule.example.com 또는 https://프로젝트ID.web.app). 비워 두면 접속한 주소를 씁니다.
PUBLIC_URL=
# 구글 캘린더 ID (캘린더 설정 > 캘린더 통합 > 캘린더 ID). 비워 두면 캘린더 연동을 하지 않습니다.
CALENDAR_ID=
# (선택) 캘린더 '비공개 iCal 주소'. 넣으면 캘린더를 공개하지 않고도 구독 링크로 쓸 수 있습니다.
CALENDAR_ICAL_URL=
